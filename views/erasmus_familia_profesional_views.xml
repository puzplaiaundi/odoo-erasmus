<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_erasmus_familia_profesional_tree" model="ir.ui.view">
        <field name="name">erasmus.familia.profesional.tree</field>
        <field name="model">erasmus.familia.profesional</field>
        <field name="arch" type="xml">
            <tree string="Familias Profesionales">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_erasmus_familia_profesional_form" model="ir.ui.view">
        <field name="name">erasmus.familia.profesional.form</field>
        <field name="model">erasmus.familia.profesional</field>
        <field name="arch" type="xml">
            <form string="Familia Profesional">
                <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_erasmus_familia_profesional" model="ir.actions.act_window">
        <field name="name">Familias Profesionales</field>
        <field name="res_model">erasmus.familia.profesional</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>