<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_erasmus_tipo_contacto_tree" model="ir.ui.view">
        <field name="name">erasmus.tipo.contacto.tree</field>
        <field name="model">erasmus.tipo.contacto</field>
        <field name="arch" type="xml">
            <tree string="Tipos de contacto Erasmus">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_erasmus_tipo_contacto_form" model="ir.ui.view">
        <field name="name">erasmus.tipo.contacto.form</field>
        <field name="model">erasmus.tipo.contacto</field>
        <field name="arch" type="xml">
            <form string="Tipo de contacto Erasmus">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_erasmus_tipo_contacto" model="ir.actions.act_window">
        <field name="name">Tipos de contacto</field>
        <field name="res_model">erasmus.tipo.contacto</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>