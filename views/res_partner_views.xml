<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_erasmus" model="ir.ui.view">
        <field name="name">res.partner.form.erasmus</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="dni_anverso" filename="dni_anverso_filename"/>
                <field name="dni_reverso" filename="dni_reverso_filename"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Erasmus">
                    <group>
                        <group>
                            <field name="es_erasmus"/>
                            <field name="tipo_contacto_erasmus_id"
                             context="{'form_view_ref': 'gestion_erasmus.view_erasmus_tipo_contacto_form'}"
                        />
                            <field name="nivel_formacion_erasmus_id"
                             context="{'form_view_ref': 'gestion_erasmus.view_erasmus_nivel_formacion_form'}"
                        />
                        </group>
                        <group>
                            <field name="erasmus_nombre"/>
                            <field name="erasmus_apellido1"/>
                            <field name="erasmus_apellido2"/>
                        </group>
                    </group>
                    <group string="Niveles de idioma">
                        <group string="Idioma 1">
                            <field name="idioma_1_id"/>
                            <field name="nivel_idioma_1_id"/>
                            <field name="idioma_1_acreditado"/>
                        </group>
                        <group string="Idioma 2">
                            <field name="idioma_2_id"/>
                            <field name="nivel_idioma_2_id"/>
                            <field name="idioma_2_acreditado"/>
                        </group>
                        <group string="Idioma 3">
                            <field name="idioma_3_id"/>
                            <field name="nivel_idioma_3_id"/>
                            <field name="idioma_3_acreditado"/>
                        </group>
                    </group>
                    <group string="Becas y otros datos">
                        <field name="erasmus_becado"/>
                        <field name="erasmus_familia_numerosa"/>
                        <field name="erasmus_discapacitado"/>
                    </group>
                </page>
                
            </xpath>
        </field>
    </record>
</odoo>
