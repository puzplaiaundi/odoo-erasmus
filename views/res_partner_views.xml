<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_erasmus" model="ir.ui.view">
        <field name="name">res.partner.form.erasmus</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Erasmus">
                    <group>
                        <group>
                            <field name="es_erasmus"/>
                            <field name="tipo_contacto_erasmus_id"/>
                        </group>
                        <group>
                            <field name="primer_apellido"/>
                            <field name="segundo_apellido"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
