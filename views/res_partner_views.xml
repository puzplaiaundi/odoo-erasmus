<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_erasmus" model="ir.ui.view">
        <field name="name">res.partner.form.erasmus</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='title']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                   <group>
                       <field name="tipo_contacto_erasmus_id"/>
                       <field name="tipo_movilidad_erasmus_id" domain="[('tipo_contacto_ids', 'in', tipo_contacto_erasmus_id)]"/>
                           <field name="erasmus_nombre" class="ge-erasmus-input"/>
                           <field name="erasmus_apellido1" class="ge-erasmus-input"/>
                           <field name="erasmus_apellido2" class="ge-erasmus-input"/>
                 </group>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="dni_anverso" filename="dni_anverso_filename"/>
                <field name="dni_reverso" filename="dni_reverso_filename"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Erasmus">
                    <group>
                        <group>
                            <field name="es_erasmus"/>
                            <field name="familia_profesional_erasmus_disponible_ids" invisible="1"/>
                            <field name="nivel_formacion_erasmus_id"
                                context="{'form_view_ref': 'gestion_erasmus.view_erasmus_nivel_formacion_form'}"
                            />
                            <field name="programa_erasmus_id"/>
                            <field name="familia_profesional_erasmus_id"
                                domain="[('id', 'in', familia_profesional_erasmus_disponible_ids)]"
                                context="{'form_view_ref': 'gestion_erasmus.view_erasmus_familia_profesional_form'}"
                            />
                            <field name="ciclo_formativo_erasmus_id"
                                domain="[('nivel_formacion_id', '=', nivel_formacion_erasmus_id), ('familia_profesional_id', '=', familia_profesional_erasmus_id)]"
                                context="{'form_view_ref': 'gestion_erasmus.view_erasmus_ciclo_formativo_form'}"
                            />
                        </group>
                    
                    </group>
                    <group string="Niveles de idioma">
                        <group string="Idioma 1">
                            <field name="idioma_1_id"/>
                            <field name="nivel_idioma_1_id"/>
                            <field name="idioma_1_acreditado"/>
                        </group>
                        <group string="Idioma 2">
                            <field name="idioma_2_id"/>
                            <field name="nivel_idioma_2_id"/>
                            <field name="idioma_2_acreditado"/>
                        </group>
                        <group string="Idioma 3">
                            <field name="idioma_3_id"/>
                            <field name="nivel_idioma_3_id"/>
                            <field name="idioma_3_acreditado"/>
                        </group>
                    </group>
                    <group string="Becas y otros datos">
                        <field name="erasmus_becado"/>
                        <field name="erasmus_familia_numerosa"/>
                        <field name="erasmus_discapacitado"/>
                    </group>
                    <group string="Movilidades">
                        <field name="movilidad_ids" context="{'default_partner_id': id, 'form_view_ref': 'gestion_erasmus.view_erasmus_movilidad_form'}">
                            <tree>
                                <field name="name"/>
                                <field name="tipo_contacto_erasmus_id" invisible="1"/>
                                <field name="tipo_movilidad_id"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="country_id"/>
                                <field name="state"/>
                            </tree>
                            <form string="Movilidad Erasmus">
                                <group>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="tipo_contacto_erasmus_id" readonly="1"/>
                                    <field name="tipo_movilidad_id"/>
                                    <field name="state"/>
                                </group>
                                <group>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="country_id"/>
                                    <field name="city"/>
                                    <field name="organization_contact_id"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
                
            </xpath>
        </field>
    </record>
</odoo>
