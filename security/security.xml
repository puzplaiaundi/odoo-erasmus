<odoo>
  <data >
    <record id="module_category_erasmus" model="ir.module.category">
      <field name="name">Erasmus</field>
      <field name="description">Gestión de roles y permisos del módulo Erasmus</field>
      <field name="sequence">25</field>
    </record>

    <record id="group_erasmus_student" model="res.groups">
      <field name="name">Alumno Erasmus</field>
      <field name="category_id" ref="gestion_erasmus.module_category_erasmus"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_erasmus_teacher" model="res.groups">
      <field name="name">Profesor Erasmus</field>
      <field name="category_id" ref="gestion_erasmus.module_category_erasmus"/>
      <field name="implied_ids" eval="[(4, ref('gestion_erasmus.group_erasmus_student'))]"/>
    </record>

    <record id="group_erasmus_coordinator" model="res.groups">
      <field name="name">Coordinador Erasmus</field>
      <field name="category_id" ref="gestion_erasmus.module_category_erasmus"/>
      <field name="implied_ids" eval="[(4, ref('gestion_erasmus.group_erasmus_teacher'))]"/>
    </record>

    <record id="group_erasmus_admin" model="res.groups">
      <field name="name">Administrador Erasmus</field>
      <field name="category_id" ref="gestion_erasmus.module_category_erasmus"/>
      <field name="implied_ids" eval="[(4, ref('gestion_erasmus.group_erasmus_coordinator'))]"/>
      <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
  </data>
</odoo>
