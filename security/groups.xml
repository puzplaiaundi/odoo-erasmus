<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_erasmus" model="ir.module.category">
        <field name="name">Erasmus</field>
        <field name="description">Permisos específicos del módulo Gestión Erasmus</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_erasmus_user" model="res.groups">
        <field name="name">Usuario Erasmus</field>
        <field name="category_id" ref="gestion_erasmus.module_category_erasmus"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_erasmus_admin" model="res.groups">
        <field name="name">Administrador Erasmus</field>
        <field name="category_id" ref="gestion_erasmus.module_category_erasmus"/>
        <field name="implied_ids" eval="[(4, ref('gestion_erasmus.group_erasmus_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>